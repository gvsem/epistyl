{
  "name": "@gvsem/epistyl",
  "version": "0.0.0",
  "description": "Minimal TypeScript library skeleton for epistyl (playground included)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "playground:build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "playground:run": "npm run playground:build && node dist/playground/index.js",
    "dev": "node ./node_modules/typescript/bin/tsc -w -p tsconfig.json",
    "start": "vite playground --open",
    "dev:web": "vite playground",
    "build:web": "vite build --outDir dist/playground --root playground",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^4.0.15"
  }
}
